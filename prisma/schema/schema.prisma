generator client {
  provider = "prisma-client"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Auth {
  id                String   @id @default(uuid())
  email             String
  password          String
  role              Role     @default(USER)
  status            Boolean  @default(true)
  isDeleted         Boolean  @default(false)
  isverified        Boolean  @default(false)
  otp               String?
  otp_status        Boolean  @default(true)
  expiredAt         DateTime @default(now())
  last_loginAt      DateTime @default(now())
  passwordChangedAt DateTime @default(now())

  isSocialLogin Boolean @default(false)

  devices String[]

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auths")
}

model User {
  id      String  @id @default(uuid())
  fname   String
  lname   String?
  email   String  @unique
  phone   String?
  address String?

  auth Auth?

  fcmToken String?

  picture ProfilePicture?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  @@map("users")
}

model ProfilePicture {
  id     String @id @default(uuid())
  url    String
  key    String
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("profile_pictures")
}

enum Role {
  ADMIN
  USER
}

model Company {
  id        String  @id @default(uuid())
  name      String
  logo      String?
  website   String?
  location  String?

  jobs      Job[]

  createdAt DateTime @default(now())
}

model Job {
  id               String  @id @default(uuid())
  title            String
  description      String
  responsibilities String?
  requirements     String?
  benefits         String?

  experience String?
  education String[]
  gender String[]

  salaryMin  Int?
  salaryMax  Int?
  currency   String? @default("USD")

  street String
  division String

  job_type        JobType        @default(Onsite)
  employment_type EmploymentType @default(Fulltime)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  applications JobApplication[]

  status   JobStatus @default(ACTIVE)
  deadline DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum JobType {
  Onsite
  Remote
}

enum EmploymentType {
  Fulltime
  Parttime
}

enum JobStatus {
  ACTIVE
  CLOSED
  DRAFT
}

model JobApplication {
  id String @id @default(uuid())

  resumeUrl   String?
  coverLetter String?

  status ApplicationStatus @default(PENDING)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id])

  createdAt DateTime @default(now())
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}
